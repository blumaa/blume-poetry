# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Configuration
ADMIN_EMAIL=desmond.blume@gmail.com

# Site URL (used in email links)
NEXT_PUBLIC_SITE_URL=https://blumenous-poetry.vercel.app

# Secret for signing one-click unsubscribe tokens (any long random string)
# Generate with: openssl rand -base64 32
UNSUBSCRIBE_SECRET=your-long-random-secret

# Gmail SMTP Configuration
# Your Gmail address
GMAIL_USER=your-email@gmail.com
# App password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-16-character-app-password
# Optional: Custom from name (defaults to "Blumenous Poetry")
EMAIL_FROM_NAME=Blumenous Poetry

# Web push (like notifications) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
